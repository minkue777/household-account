<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/startupImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/startup_background"
        android:contentDescription="@string/startup_loading"
        android:padding="24dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/startupContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/startupArtwork"
                android:layout_width="@dimen/startup_artwork_size"
                android:layout_height="@dimen/startup_artwork_size"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/startup_illustration" />

            <TextView
                android:id="@+id/startupHouseholdName"
                android:layout_width="match_parent"
                android:layout_height="@dimen/startup_title_height"
                android:layout_marginTop="@dimen/startup_title_margin_top"
                android:fontFamily="@font/jua_regular"
                android:gravity="center"
                android:includeFontPadding="false"
                android:textColor="#36578B"
                android:textSize="@dimen/startup_title_text_size"
                android:textStyle="normal"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/startupSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/startup_subtitle_height"
                android:layout_marginTop="@dimen/startup_subtitle_margin_top"
                android:gravity="center"
                android:includeFontPadding="false"
                android:letterSpacing="0.18"
                android:text="@string/startup_subtitle"
                android:textColor="#52698F"
                android:textSize="@dimen/startup_subtitle_text_size"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:id="@+id/startupDots"
            android:layout_width="37dp"
            android:layout_height="7dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="@dimen/startup_dots_bottom_margin"
            android:background="@drawable/startup_dots"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/permissionLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="앱 권한 설정 필요"
            android:textColor="#1E293B"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="카드 결제 알림을 자동으로 기록하려면&#10;아래 두 가지 권한이 필요합니다."
            android:textColor="#64748B"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnRequestPermission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="1. 알림 접근 권한 설정"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnRequestOverlayPermission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="2. 다른 앱 위에 표시 권한 설정"
            android:textSize="16sp"
            android:visibility="visible" />

        <Button
            android:id="@+id/btnCheckPermission"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="권한 확인"
            android:textSize="16sp" />

        <androidx.cardview.widget.CardView
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            app:cardBackgroundColor="#F1F5F9"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="설정 방법"
                    android:textColor="#1E293B"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="4dp"
                    android:text="알림 접근: 카드 결제 알림 감지&#10;다른 앱 위에 표시: 결제 후 바로 편집창 띄우기&#10;&#10;각 버튼을 눌러 설정 후 '권한 확인'을 누르세요"
                    android:textColor="#64748B"
                    android:textSize="14sp" />
            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</FrameLayout>

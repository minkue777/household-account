{
  "name": "household-account",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e:functions": "npm --prefix ../functions run build",
    "test:e2e:install": "playwright install chromium",
    "pretest:e2e": "npm run test:e2e:functions && npm run test:e2e:install",
    "test:e2e": "node ../functions/scripts/run-with-emulator-secret.mjs firebase --config ../firebase.e2e.json emulators:exec --project demo-household-account-e2e --only auth,firestore,functions --log-verbosity QUIET \"npm run test:e2e:playwright\"",
    "test:e2e:playwright": "playwright test"
  },
  "dependencies": {
    "chart.js": "^4.4.0",
    "firebase": "^12.16.0",
    "lucide-react": "^0.469.0",
    "next": "^14.2.0",
    "next-pwa": "^5.6.0",
    "pretendard": "^1.3.9",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.0.0",
    "eslint-config-next": "^14.2.0",
    "firebase-tools": "15.4.0",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^29.0.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.0.0"
  }
}
